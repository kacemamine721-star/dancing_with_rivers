# Copy to .env.local (gitignored). No secrets belong in the frontend: everything here is public.

# Base URL of the versioned data bundle (path on this site, or a CDN URL).
VITE_DATA_BASE_URL=/data/2026-11-15

# Optional error reporting (off when empty).
VITE_SENTRY_DSN=

# Optional privacy-friendly analytics (off when empty).
VITE_ANALYTICS=
