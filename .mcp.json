{
  "mcpServers": {
    "playwright": {
      "command": "cmd",
      "args": ["/c", "npx", "-y", "--registry=https://registry.yarnpkg.com", "@playwright/mcp@0.0.85", "--isolated"]
    },
    "chrome-devtools": {
      "command": "cmd",
      "args": ["/c", "npx", "-y", "--registry=https://registry.yarnpkg.com", "chrome-devtools-mcp@1.13.0", "--isolated"]
    },
    "context7": {
      "command": "cmd",
      "args": ["/c", "npx", "-y", "--registry=https://registry.yarnpkg.com", "@upstash/context7-mcp@4.7.0"]
    },
    "shadcn": {
      "command": "cmd",
      "args": ["/c", "npx", "-y", "--registry=https://registry.yarnpkg.com", "shadcn@4.23.0", "mcp"]
    }
  }
}
