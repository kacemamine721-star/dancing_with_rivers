          "title": "Cropland Ha",
          "type": "number"
        },
        "builtup_ha": {
          "title": "Builtup Ha",
          "type": "number"
        },
        "buildings": {
          "title": "Buildings",
          "type": "integer"
        },
        "road_km": {
          "title": "Road Km",
          "type": "number"
        },
        "villages": {
          "items": {
            "$ref": "#/$defs/VillageImpact"
          },
          "title": "Villages",
          "type": "array"
        }
      },
      "required": [
        "cropland_ha",
        "builtup_ha",
        "buildings",
        "road_km",
        "villages"
      ],
      "title": "ScenarioImpact",
      "type": "object"
    },
    "VillageImpact": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "arrival_h": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Arrival H"
        },
        "max_depth_m": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Depth M"
        }
      },
      "required": [
        "name"
      ],
      "title": "VillageImpact",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "badge": {
      "enum": [
        "MEASURED",
        "REPORTED",
        "MODELLED",
        "ILLUSTRATIVE"
      ],
      "title": "Badge",
      "type": "string"
    },
    "source": {
      "title": "Source",
      "type": "string"
    },
    "method": {
      "default": "",
      "title": "Method",
      "type": "string"
    },
    "uncertainty": {
      "default": "",
      "title": "Uncertainty",
      "type": "string"
    },
    "placeholder": {
      "default": false,
      "title": "Placeholder",
      "type": "boolean"
    },
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "dam_id": {
      "title": "Dam Id",
      "type": "string"
    },
    "scenarios": {
      "additionalProperties": {
        "$ref": "#/$defs/ScenarioImpact"
      },
      "title": "Scenarios",
      "type": "object"
    }
  },
  "required": [
    "badge",
    "source",
    "dam_id",
    "scenarios"
  ],
  "title": "Impacts",
  "type": "object",
  "$id": "https://dancing-with-dams/contracts/impacts.schema.json",
  "x-schema-version": 1
